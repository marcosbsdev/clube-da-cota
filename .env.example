# ==========================================
# CLUBE DA COTA - VARIÁVEIS DE AMBIENTE
# ==========================================

# 1. Modo Docker Local (PostgreSQL no container db)
DATABASE_URL="postgresql://postgres:postgres@db:5432/clube_da_cota?schema=public"

# 2. Modo Host Local conectando no PostgreSQL do Docker (porta exposta 5432)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clube_da_cota?schema=public"

# 3. Modo Supabase (PostgreSQL Gerenciado na Nuvem)
# DATABASE_URL="postgresql://postgres:[SUA_SENHA]@db.[SEU_PROJETO].supabase.co:5432/postgres"

# 4. Modo Servidor Dedicado / VPS Próprio
# DATABASE_URL="postgresql://postgres:[SENHA_FORTE]@localhost:5432/clube_da_cota?schema=public"

# Porta do servidor (padrão: 3000)
PORT=3000
NODE_ENV=production
